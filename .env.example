# Copia este archivo a .env y rellena los valores reales. .env nunca se sube al repositorio.
# Este mismo .env lo usan tanto la ejecución directa (node app.js) como los tres
# servicios de docker-compose.yml (mariadb, web, notifier).

# --- Base de datos (MariaDB) ---
# En local (sin Docker) usa el host donde tengas MariaDB, p.ej. localhost.
# Dentro de docker-compose, docker-compose.yml sobrescribe esto automáticamente a
# "mariadb" (el nombre del servicio) porque ahí la BD también está dockerizada.
DB_HOST=localhost
DB_DB=pelis

# Solo lo usa el contenedor mariadb, para crear la BD e inicializar los usuarios de
# aplicación de abajo (ver db/02-users.sh). No lo necesita la app ni el notifier.
DB_ROOT_PWD=

# Usuario con permisos sobre `form`/`newmovies`/`notificaciones` (incidencias, catálogo,
# cola de avisos). Se crea solo/a en el primer arranque de Docker (db/02-users.sh); si
# usas una BD ya existente fuera de Docker, créalo tú a mano con esos mismos permisos.
DB_USER=web
DB_PWD=

# Usuario con permisos sobre `usuarios` (login, alta de cuentas)
DB_USER2=usuarios
DB_PWD2=

# Nº máximo de conexiones simultáneas por pool
DB_CONNECTION_LIMIT=3

# --- Sesión ---
# Secreto usado para firmar la cookie de sesión. Genera uno propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Cuenta admin inicial ---
# Si están definidas, la app crea esta cuenta (rol admin) al arrancar, solo si no existe
# ya un usuario con ese nombre — pensado para el primer arranque con una BD nueva/vacía
# (p.ej. Docker). Cámbiale la contraseña después de entrar, o simplemente no dejes estas
# variables puestas una vez ya tengas cuentas admin creadas.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Correo (usado por notifier/notificacion_correo.py para avisar de nuevas solicitudes) ---
EMAIL_USER=
EMAIL_PASS=
# Segundos entre comprobaciones de la tabla `notificaciones` (opcional, por defecto 3600)
# NOTIFY_POLL_INTERVAL=3600

# --- Servidor web (opcionales, tienen valores por defecto) ---
# PORT=3002
# HOST=0.0.0.0

# --- Feed RSS de pendientes (opcional) ---
# Si se define, expone /api/rss/pendientes?token=<este valor> con las solicitudes/
# incidencias sin resolver, en formato RSS, para consumir desde un lector externo
# como el widget RSS de Homarr (que no puede autenticarse con la cookie de sesión).
# Si se deja vacío, la ruta responde 404. Genera un valor propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RSS_TOKEN=

# La app sirve HTTP plano; el TLS lo pone el reverse proxy delante de ella.
# COOKIE_SECURE=false # solo para pruebas locales sin proxy delante y sin usar "localhost"
