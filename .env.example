# Copia este archivo a .env y rellena los valores reales. .env nunca se sube al repositorio.

# --- Base de datos (MariaDB) ---
DB_HOST=localhost
DB_DB=pelis

# Usuario con permisos de lectura/escritura sobre la tabla `form` (incidencias/solicitudes)
DB_USER=web
DB_PWD=

# Usuario con permisos sobre la tabla `usuarios` (login, registro de cuentas)
DB_USER2=usuarios
DB_PWD2=

# Nº máximo de conexiones simultáneas por pool
DB_CONNECTION_LIMIT=3

# --- Sesión ---
# Secreto usado para firmar la cookie de sesión. Genera uno propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Correo (usado por Scripts/NotificacionCorreo.py para notificar nuevas solicitudes) ---
EMAIL_USER=
EMAIL_PASS=

# --- Servidor (opcionales, tienen valores por defecto) ---
# PORT=3002
# HOST=0.0.0.0
