# Copia este archivo a .env y rellena los valores reales. .env nunca se sube al repositorio.

# --- Base de datos (MariaDB) ---
# Este mismo .env lo usan tanto la ejecución directa (node app.js) como docker-compose.
# En local, DB_HOST=localhost. Dentro de Docker, docker-compose.yml lo sobrescribe a
# host.docker.internal automáticamente (la BD sigue viviendo en el host, no se dockeriza).
DB_HOST=localhost
DB_DB=pelis

# Usuario con permisos de lectura/escritura sobre la tabla `form` (incidencias/solicitudes)
DB_USER=web
DB_PWD=

# Usuario con permisos sobre la tabla `usuarios` (login, registro de cuentas)
DB_USER2=usuarios
DB_PWD2=

# Nº máximo de conexiones simultáneas por pool
DB_CONNECTION_LIMIT=3

# --- Sesión ---
# Secreto usado para firmar la cookie de sesión. Genera uno propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Correo (usado por notifier/notificacion_correo.py para avisar de nuevas solicitudes) ---
EMAIL_USER=
EMAIL_PASS=
# Segundos entre comprobaciones de la tabla `notificaciones` (opcional, por defecto 3600)
# NOTIFY_POLL_INTERVAL=3600

# --- Servidor web (opcionales, tienen valores por defecto) ---
# PORT=3002
# HOST=0.0.0.0

# La app sirve HTTP plano; el TLS lo pone el reverse proxy delante de ella.
# Actívalo cuando ese proxy esté en marcha (si no, deja las dos sin poner):
# TRUST_PROXY=1       # confía en X-Forwarded-* del proxy (IP real, proto)
# COOKIE_SECURE=false # solo para pruebas locales SIN proxy delante y sin ser "localhost"
